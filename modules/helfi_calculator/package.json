{
  "name": "helfi_calculator",
  "description": "Asset builder configuration for helfi_calcultar",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-helfi-platform-config",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the sandbox command."
  ],
  "scripts": {
    "preinstall": "npm install ../../../../../themes/contrib/hdbt/theme-builder --loglevel=silent",
    "dev": "sandbox node theme-builder.mjs --watch --dev",
    "build": "sandbox sh -c 'biome check --fix assets/js/ && node theme-builder.mjs'",
    "lint:js": "sandbox biome lint --fix assets/js/",
    "format:js": "sandbox biome format --fix assets/js/",
    "lint": "sandbox npm-run-all --parallel lint:js -s"
  },
  "dependencies": {
    "@hdbt/theme-builder": "file:../../../../../themes/contrib/hdbt/theme-builder",
    "glob": "^11.0.0",
    "mustache": "^4.2.0",
    "npm-run-all2": "^8.0.4"
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false
  }
}
