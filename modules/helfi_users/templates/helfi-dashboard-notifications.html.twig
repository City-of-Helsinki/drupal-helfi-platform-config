{#
/**
 * @file
 * Default theme implementation for user dashboard notifications.
 *
 * Available variables:
 * - notifications: List of \Drupal\helfi_users\Dashboard\DashboardNotification
 *   objects, each with a label and a url.
 */
#}
<ul class="dashboard-notifications">
  {% for notification in notifications %}
    <li class="dashboard-notifications__item">
      <span class="hel-icon hel-icon--info-circle-fill" aria-hidden="true"></span>
      {{ link(notification.label, notification.url, {'class': ['dashboard-notifications__link']}) }}
    </li>
  {% endfor %}
</ul>
