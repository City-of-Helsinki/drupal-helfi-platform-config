<?php

/**
 * @file
 * Contains installation tasks for helfi_paragraphs_content_cards module.
 */

declare(strict_types=1);

use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\Core\Entity\Exception\FieldStorageDefinitionUpdateForbiddenException;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\helfi_api_base\Environment\ActiveProjectRoles;
use Drupal\helfi_api_base\Environment\ProjectRoleEnum;

/**
 * Implements hook_install().
 */
function helfi_paragraphs_content_cards_install(): void {
  helfi_paragraphs_content_cards_configure_displays();
}

/**
 * UHF-9088: Updated config translations for helfi_paragraphs_content_cards.
 */
function helfi_paragraphs_content_cards_update_9001() : void {
  \Drupal::service('helfi_platform_config.config_update_helper')
    ->update('helfi_paragraphs_content_cards');
}

/**
 * UHF-8982 Remove grey options, change to use allowed_values_function.
 */
function helfi_paragraphs_content_cards_update_9002(): void {
  try {
    $old_rows = \Drupal::database()
      ->select('paragraph__field_content_cards_design')
      ->fields('paragraph__field_content_cards_design')
      ->condition('bundle', 'content_cards')
      ->execute()
      ->fetchAll();

    if (!$old_rows) {
      return;
    }

    foreach ($old_rows as $row) {
      $values = (array) $row;
      $original_design = $values['field_content_cards_design_value'] ?? NULL;

      // Skip if there's no value.
      if (!$original_design) {
        continue;
      }

      // Map the old grey styles to the new ones.
      $new_design = match ($original_design) {
        'small-cards-grey' => 'small-cards',
        'large-cards-grey' => 'large-cards',
        default => $original_design,
      };

      // Skip if nothing changed.
      if ($new_design === $original_design) {
        continue;
      }

      // Update the record.
      \Drupal::database()
        ->update('paragraph__field_content_cards_design')
        ->fields(['field_content_cards_design_value' => $new_design])
        ->condition('entity_id', $values['entity_id'])
        ->condition('revision_id', $values['revision_id'])
        ->execute();
    }
  }
  catch (\Exception $e) {
    \Drupal::messenger()->addMessage(t('Transforming old content cards design values failed.'));
    return;
  }
  try {
    $field_content_cards_design = FieldStorageConfig::loadByName('paragraph', 'field_content_cards_design');
    $field_content_cards_design->setSetting('allowed_values', []);
    $field_content_cards_design->setSetting('allowed_values_function', 'helfi_paragraphs_content_cards_allowed_values');
    $field_content_cards_design->save();
  }
  catch (FieldStorageDefinitionUpdateForbiddenException $exception) {
    // We know the database values are different what we are trying to write,
    // but we are only replacing the values with an allowed_values_function.
  }
}

/**
 * Chooses the content cards reference field for the active project.
 */
function helfi_paragraphs_content_cards_update_9003(): void {
  helfi_paragraphs_content_cards_configure_displays();
}

/**
 * Saves content cards displays based on active project's index role.
 *
 * Instances that have access to the frontpage index should use the external
 * entity based entity reference field for content cards, while the rest should
 * stick to the node based one.
 */
function helfi_paragraphs_content_cards_configure_displays(): void {
  $roles = \Drupal::service(ActiveProjectRoles::class);
  assert($roles instanceof ActiveProjectRoles);
  $has_index = $roles->hasRole(ProjectRoleEnum::HasEtusivuIndex);
  $node_reference_field = 'field_content_cards_content';
  $external_entity_reference_field = 'field_content_cards_content_ext';
  $visible = $has_index ? $external_entity_reference_field : $node_reference_field;
  $hidden = $has_index ? $node_reference_field : $external_entity_reference_field;

  $form_display = EntityFormDisplay::load('paragraph.content_cards.default');
  if (!$form_display instanceof EntityFormDisplay) {
    $form_display = EntityFormDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'content_cards',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $form_display
    ->setComponent('field_content_cards_title', [
      'type' => 'string_textfield',
      'weight' => 0,
      'region' => 'content',
      'settings' => [
        'size' => 60,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ])
    ->setComponent('field_content_cards_desc', [
      'type' => 'text_textarea',
      'weight' => 1,
      'region' => 'content',
      'settings' => [
        'rows' => 5,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ])
    ->setComponent('field_content_cards_design', [
      'type' => 'design_field_widget',
      'weight' => 2,
      'region' => 'content',
      'settings' => [],
      'third_party_settings' => [],
    ])
    ->setComponent($visible, [
      'type' => 'entity_reference_autocomplete',
      'weight' => 3,
      'region' => 'content',
      'settings' => [
        'match_operator' => 'CONTAINS',
        'match_limit' => 10,
        'size' => 60,
        'placeholder' => '',
      ],
      'third_party_settings' => [],
    ])
    ->removeComponent($hidden)
    ->removeComponent('created')
    ->removeComponent('status')
    ->save();

  $display_options = [
    'type' => 'entity_reference_entity_view',
    'label' => 'hidden',
    'settings' => [
      'view_mode' => 'teaser',
      'link' => FALSE,
    ],
    'third_party_settings' => [],
    'weight' => 2,
    'region' => 'content',
  ];
  if ($has_index) {
    $display_options['type'] = 'content_cards_htmx';
    $display_options['settings'] = [];
  }

  $view_display = EntityViewDisplay::load('paragraph.content_cards.default');
  if (!$view_display instanceof EntityViewDisplay) {
    $view_display = EntityViewDisplay::create([
      'targetEntityType' => 'paragraph',
      'bundle' => 'content_cards',
      'mode' => 'default',
      'status' => TRUE,
    ]);
  }
  $view_display
    ->setComponent('field_content_cards_title', [
      'type' => 'string',
      'label' => 'hidden',
      'settings' => [
        'link_to_entity' => FALSE,
        'link_rel' => 'canonical',
      ],
      'third_party_settings' => [],
      'weight' => 0,
      'region' => 'content',
    ])
    ->setComponent('field_content_cards_design', [
      'type' => 'list_key',
      'label' => 'inline',
      'settings' => [],
      'third_party_settings' => [],
      'weight' => 1,
      'region' => 'content',
    ])
    ->setComponent($visible, $display_options)
    ->setComponent('field_content_cards_desc', [
      'type' => 'text_default',
      'label' => 'hidden',
      'settings' => [],
      'third_party_settings' => [],
      'weight' => 3,
      'region' => 'content',
    ])
    ->removeComponent($hidden)
    ->removeComponent('search_api_excerpt')
    ->save();
}
