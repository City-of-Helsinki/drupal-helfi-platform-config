<?php

/**
 * @file
 * Contains installation tasks for helfi_paragraphs_banner module.
 */

declare(strict_types=1);

use Drupal\paragraphs\Entity\Paragraph;
use Drupal\paragraphs\ParagraphInterface;

/**
 * UHF-6469: Remove centered banner designs and convert them to be left aligned.
 */
function helfi_paragraphs_banner_update_9001() : void {
  // Get all paragraphs with centered design.
  $pids = \Drupal::entityQuery('paragraph')
    ->condition('type', 'banner')
    ->condition('field_banner_design', [
      'align-center',
      'align-center-secondary',
    ], "IN")
    ->execute();

  $paragraphs = Paragraph::loadMultiple($pids);

  // Convert to left aligned design.
  /** @var \Drupal\paragraphs\ParagraphInterface $paragraph */
  foreach ($paragraphs as $paragraph) {
    if ($paragraph instanceof ParagraphInterface) {
      $field_update_map = [
        'align-center' => 'align-left',
        'align-center-secondary' => 'align-left-secondary',
      ];

      $paragraph
        ->set('field_banner_design', $field_update_map[$paragraph->get('field_banner_design')->value])
        ->save();
    }
  }

  // Re-import 'helfi_paragraphs_banner' configuration.
  \Drupal::service('helfi_platform_config.config_update_helper')
    ->update('helfi_paragraphs_banner');
}

/**
 * UHF-9088: Updated configuration translations for helfi_paragraphs_banner.
 */
function helfi_paragraphs_banner_update_9002() : void {
  \Drupal::service('helfi_platform_config.config_update_helper')
    ->update('helfi_paragraphs_banner');
}

/**
 * UHF-13147: Install the "hide from table of contents" toggle for banner.
 */
function helfi_paragraphs_banner_update_9003() : void {
  \Drupal::service('helfi_platform_config.config_update_helper')
    ->update('helfi_paragraphs_banner');

  $field = 'field_banner_hide_from_toc';
  $dependency = "field.field.paragraph.banner.$field";

  $displays = [
    'core.entity_form_display.paragraph.banner.default' => [
      "content.$field" => [
        'type' => 'boolean_checkbox',
        'weight' => 6,
        'region' => 'content',
        'settings' => ['display_label' => TRUE],
        'third_party_settings' => [],
      ],
    ],
    'core.entity_view_display.paragraph.banner.default' => [
      "hidden.$field" => TRUE,
    ],
  ];

  foreach ($displays as $name => $components) {
    $display = \Drupal::configFactory()->getEditable($name);

    if ($display->isNew()) {
      continue;
    }

    $dependencies = $display->get('dependencies.config') ?? [];

    if (!in_array($dependency, $dependencies, TRUE)) {
      $dependencies[] = $dependency;
      sort($dependencies);
      $display->set('dependencies.config', $dependencies);
    }

    foreach ($components as $key => $value) {
      if ($display->get($key) === NULL) {
        $display->set($key, $value);
      }
    }

    $display->save();
  }
}
