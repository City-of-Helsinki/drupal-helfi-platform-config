<div class="ai-title-suggestions">
  <div class="ai-title-suggestions__original">
    <p class="ai-title-suggestions__heading">{{ 'Original title:'|t({}, {'context': 'Helfi AI'}) }}</p>
    <p class="ai-title-suggestions__original-value">{{ original_title ?: '–' }}</p>
  </div>
  <fieldset class="ai-title-suggestions__options">
    <legend class="ai-title-suggestions__heading">{{ 'AI suggestions:'|t({}, {'context': 'Helfi AI'}) }}</legend>
    {% for suggestion in suggestions %}
      {% set id = 'ai-title-suggestions__option-' ~ loop.index0 %}
      <div class="form-item form-type--radio form-type--boolean ai-title-suggestions__option">
        <input
          type="radio"
          name="helfi_ai_title"
          id="{{ id }}"
          class="form-radio form-boolean form-boolean--type-radio ai-title-suggestions__option-input"
          value="{{ suggestion }}"
        />
        <label for="{{ id }}" class="form-item__label option ai-title-suggestions__option-label">{{ suggestion }}</label>
      </div>
    {% endfor %}
  </fieldset>
  <div class="form-actions ai-title-suggestions__actions">
    <button type="button" class="button button--primary ai-title-suggestions__apply" disabled>{{ 'Select suggestion'|t({}, {'context': 'Helfi AI'}) }}</button>
    <button type="button" class="button button--secondary ai-title-suggestions__cancel">{{ 'Cancel'|t({}, {'context': 'Helfi AI'}) }}</button>
  </div>
</div>
