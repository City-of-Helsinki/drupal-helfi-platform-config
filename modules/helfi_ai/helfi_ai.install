<?php

/**
 * @file
 * Installation hooks for helfi_ai.
 */

declare(strict_types=1);

use Drupal\user\Entity\Role;

/**
 * Implements hook_install().
 */
function helfi_ai_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  $manager = \Drupal::entityDefinitionUpdateManager();
  $entityTypeManager = \Drupal::entityTypeManager();
  $fieldManager = \Drupal::service('entity_field.manager');

  // Map each entity type to the module that defines its ai_summary field.
  $providers = [
    'node' => 'helfi_ai',
    'tpr_service' => 'helfi_tpr_config',
  ];

  foreach ($providers as $entityTypeId => $provider) {
    if (!$entityTypeManager->hasDefinition($entityTypeId)) {
      continue;
    }
    $definition = $fieldManager->getFieldStorageDefinitions($entityTypeId)['ai_summary'] ?? NULL;

    if ($definition && !$manager->getFieldStorageDefinition('ai_summary', $entityTypeId)) {
      $manager->installFieldStorageDefinition('ai_summary', $entityTypeId, $provider, $definition);
    }
  }
}

/**
 * By default, disable the AI functionalities for existing installations.
 */
function helfi_ai_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('helfi_ai.settings');
  foreach (['enable_seo_title', 'enable_tone_check', 'enable_ai_summary'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, FALSE);
    }
  }
  $config->save();
}

/**
 * Remove AI permissions from all roles. Grant permission to 'admin' role.
 */
function helfi_ai_update_11002(): void {
  /** @var \Drupal\user\RoleInterface[] $roles */
  $roles = Role::loadMultiple();

  $permissions = [
    'use helfi ai title suggestion',
    'use helfi ai tone check',
    'use helfi ai summary',
  ];

  foreach ($roles as $role) {
    foreach ($permissions as $permission) {
      if (!$role->hasPermission($permission)) {
        continue;
      }
      $role->revokePermission($permission);
    }
    $role->save();
  }

  if ($role = Role::load('admin')) {
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}
