<?php

/**
 * @file
 * Installation hooks for helfi_ai.
 */

declare(strict_types=1);
use Drupal\user\Entity\Role;
use Drupal\user\Plugin\views\access\Permission;

/**
 * Implements hook_install().
 */
function helfi_ai_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }
  $manager = \Drupal::entityDefinitionUpdateManager();
  $definition = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('node')['ai_summary'] ?? NULL;
  if ($definition && !$manager->getFieldStorageDefinition('ai_summary', 'node')) {
    $manager->installFieldStorageDefinition('ai_summary', 'node', 'helfi_ai', $definition);
  }
}

/**
 * By default, disable the AI functionalities for existing installations.
 */
function helfi_ai_update_11001(): void {
  $config = \Drupal::configFactory()->getEditable('helfi_ai.settings');
  foreach (['enable_seo_title', 'enable_tone_check', 'enable_ai_summary'] as $key) {
    if ($config->get($key) === NULL) {
      $config->set($key, FALSE);
    }
  }
  $config->save();
}

/**
 * Remove AI permissions from all roles. Grant permission to 'admin' role.
 */
function helfi_ai_update_11002(): void {
  /** @var \Drupal\user\RoleInterface[] $roles */
  $roles = Role::loadMultiple();

  $permissions = ['use helfi ai title suggestion', 'use helfi ai tone check'];

  foreach ($roles as $role) {
    foreach ($permissions as $permission) {
      if (!$role->hasPermission($permission)) {
        continue;
      }
      $role->revokePermission($permission);
    }
    $role->save();
  }

  if ($role = Role::load('admin')) {
    foreach ($permissions as $permission) {
      $role->grantPermission($permission);
    }
    $role->save();
  }
}
