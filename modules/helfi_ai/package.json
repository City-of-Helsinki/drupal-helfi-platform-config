{
  "name": "helfi-ai",
  "version": "1.0.0",
  "description": "HELfi AI CKEditor 5 plugins.",
  "scripts": {
    "watch": "webpack --mode development --watch",
    "build": "npm run format:js --loglevel=silent && npm run lint:js --loglevel=silent && webpack",
    "lint:js": "biome lint assets/js/ckeditor5_plugins/",
    "format:js": "biome format --write assets/js/ckeditor5_plugins/"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.6",
    "@ckeditor/ckeditor5-core": "^47.6.2",
    "@ckeditor/ckeditor5-dev-utils": "^62.5.0",
    "@nuxt/friendly-errors-webpack-plugin": "^2.5.1",
    "ckeditor5": "^47.6.2",
    "diff": "^8.0.2",
    "raw-loader": "^4.0.2",
    "terser-webpack-plugin": "^5.3.3",
    "webpack": "^5.51.1",
    "webpack-cli": "^4.4.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
