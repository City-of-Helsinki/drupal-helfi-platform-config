{
  "name": "helfi-ckeditor",
  "version": "1.0.0",
  "description": "Helfi specific enhancements to CKEditor5 plugins.",
  "scripts": {
    "watch": "webpack --mode development --watch",
    "build": "npm run format:js --loglevel=silent && npm run lint:js --loglevel=silent && webpack",
    "lint:js": "biome lint assets/js/ckeditor5_plugins/",
    "format:js": "biome format --write assets/js/ckeditor5_plugins/"
  },
  "@comment dependencies": [
    "The following packages were updated manually.",
    "Remove this section once the dependencies have been updated in their respective upstream packages.",
    {
      "diff": "^8.0.3, dependency of ckeditor5-dev",
      "glob": "^14.0.2, dependency of ckeditor5-dev-utils and ckeditor5-dev-translations",
      "minimatch": ">=11.0.9, dependency of ckeditor5-dev-utils",
      "serialize-javascript": "^7.0.3, dependency of ckeditor5-dev-translations",
      "simple-git": "^4.0.2, dependency of ckeditor5-dev-utils"
    }
  ],
  "overrides": {
    "diff": "^8.0.3",
    "glob": "^14.0.2",
    "minimatch": "^11.0.9",
    "serialize-javascript": "^7.0.3",
    "simple-git": "^4.0.2"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.6",
    "@ckeditor/ckeditor5-core": "^47.7.4",
    "@ckeditor/ckeditor5-dev-translations": "^53.4.0",
    "@ckeditor/ckeditor5-dev-utils": "^62.5.0",
    "@ckeditor/ckeditor5-icons": "^47.7.4",
    "@nuxt/friendly-errors-webpack-plugin": "^2.5.1",
    "ckeditor5": "^47.7.4",
    "css-loader": "^6.8.1",
    "raw-loader": "^4.0.2",
    "terser-webpack-plugin": "^5.3.3",
    "webpack": "^5.51.1",
    "webpack-cli": "^4.4.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
