{
  "name": "hdbt_platform_config",
  "description": "Asset builder configuration for helfi_platform_config",
  "author": "Druid",
  "license": "MIT",
  "repository": "github:City-of-Helsinki/drupal-helfi-platform-config",
  "@comment scripts": [
    "Every build, lint and format script below runs inside a disposable Node container via the sandbox command."
  ],
  "scripts": {
    "preinstall": "npm install ../../../themes/contrib/hdbt/theme-builder --loglevel=silent",
    "dev": "sandbox node theme-builder.mjs --watch --dev",
    "build": "sandbox sh -c 'npm run format:js --loglevel=silent && npm run lint --loglevel=silent && node theme-builder.mjs'",
    "lint:js": "sandbox biome lint assets/js/",
    "format:js": "sandbox biome format --write assets/js/",
    "lint": "sandbox npm-run-all --parallel lint:js -s"
  },
  "dependencies": {
    "@drupal/autocomplete": "^0.0.2",
    "@hdbt/theme-builder": "file:../../../themes/contrib/hdbt/theme-builder",
    "npm-run-all2": "^8.0.4",
    "tom-select": "^2.6.0"
  },
  "engines": {
    "npm": ">=12.0.0",
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false
  }
}
