{#
/**
 * @file
 * Default theme implementation for entity notifications.
 *
 * Available variables:
 * - notifications: List of
 *   \Drupal\helfi_platform_config\EntityNotifications\EntityNotification
 *   objects, each with a label, a url and an optional icon.
 */
#}
<ul class="entity-notifications">
  {% for notification in notifications %}
    <li class="entity-notifications__item">
      {% set label -%}
        {% if notification.icon %}<span class="hel-icon hel-icon--{{ notification.icon }}" aria-hidden="true"></span>{% endif %}{{ notification.label }}
      {%- endset %}
      {{ link(label, notification.url, {'class': ['entity-notifications__link']}) }}
    </li>
  {% endfor %}
</ul>
