{#
/**
 * @file
 * Default theme implementation for entity notifications.
 *
 * Available variables:
 * - notifications: List of \Drupal\helfi_users\EntityNotifications\EntityNotification
 *   objects, each with a label and a url.
 */
#}
<ul class="entity-notifications">
  {% for notification in notifications %}
    <li class="entity-notifications__item">
      <span class="hel-icon hel-icon--info-circle-fill" aria-hidden="true"></span>
      {{ link(notification.label, notification.url, {'class': ['entity-notifications__link']}) }}
    </li>
  {% endfor %}
</ul>
