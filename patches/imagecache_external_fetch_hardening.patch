 /**
+ * Checks that the content is an image.
+ *
+ * The Content-Type header can't be trusted, and responses without it are
+ * treated as application/octet-stream.
+ *
+ * @param string $content
+ *   The content.
+ * @param string $content_type
+ *   The content type of the response.
+ *
+ * @return bool
+ *   TRUE if the content is an image.
+ */
+function imagecache_external_is_image(string $content, string $content_type): bool {
+  // SVG images are validated by imagecache_sanitize_svg().
+  if ($content_type === 'image/svg+xml') {
+    return TRUE;
+  }
+  return getimagesizefromstring($content) !== FALSE;
+}
