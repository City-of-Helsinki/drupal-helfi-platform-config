+    parent::setUp();
+
+    $this->installSchema('search_api', ['search_api_item']);
+    $this->installConfig('search_api');
+
+    $this->index = Index::create([
+      'id' => 'index',
+      'tracker_settings' => [
+        'parallel' => [],
+      ],
+    ]);
+    $this->tracker = $this->index->getTrackerInstance();
+    $this->timeService = new TestTimeService();
+    $this->tracker->setTimeService($this->timeService);
+  }
+
+  /**
+   * Tests the single-worker claim cycle.
+   *
+   * @covers ::lock
+   * @covers ::getRemainingItems
+   * @covers ::trackItemsIndexed
+   * @covers ::unlock
+   */
+  public function testSingleWorkerClaimCycle(): void {
+    $this->insertItems(['a', 'b', 'c']);
+
+    $this->tracker->lock();
+    $claimed = $this->tracker->getRemainingItems(2);
+    $this->assertCount(2, $claimed);
+
+    // DB rows for claimed items should have worker_id and expires_at set.
+    foreach ($claimed as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertEquals(TrackerPluginBase::STATUS_CLAIMED, $row->status);
+      $this->assertNotNull($row->worker_id, "worker_id should be set after claiming $id");
+      $this->assertNotNull($row->expires_at, "expires_at should be set after claiming $id");
+    }
+
+    // After indexing, rows should be cleared.
+    $this->tracker->trackItemsIndexed($claimed);
+    foreach ($claimed as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertEquals(TrackerPluginBase::STATUS_INDEXED, $row->status);
+      $this->assertNull($row->worker_id);
+      $this->assertNull($row->expires_at);
+    }
