diff --git a/src/Plugin/search_api/tracker/Parallel.php b/src/Plugin/search_api/tracker/Parallel.php
new file mode 100644
index 0000000000000000000000000000000000000000..d3d697fd6968677cb165bbc45025a3e87f28a1ee
--- /dev/null
+++ b/src/Plugin/search_api/tracker/Parallel.php
@@ -0,0 +1,308 @@
+<?php
+
+namespace Drupal\search_api\Plugin\search_api\tracker;
+
+use Drupal\Component\Uuid\UuidInterface;
+use Drupal\Core\Database\Query\SelectInterface;
+use Drupal\Core\Form\FormStateInterface;
+use Drupal\Core\StringTranslation\TranslatableMarkup;
+use Drupal\search_api\Attribute\SearchApiTracker;
+use Symfony\Component\DependencyInjection\ContainerInterface;
+
+/**
+ * Provides a tracker implementation which supports parallel indexing.
+ */
+#[SearchApiTracker(
+  id: 'parallel',
+  label: new TranslatableMarkup('Parallel indexing'),
+  description: new TranslatableMarkup('Tracker that supports parallel indexing.')
+)]
+class Parallel extends Basic {
+
+  /**
+   * The UUID service.
+   */
+  protected UuidInterface $uuidService;
+
+  /**
+   * The current worker ID for this instance.
+   */
+  protected ?string $currentWorkerId = NULL;
+
+  /**
+   * The lock timeout for this indexing session.
+   */
+  protected int $lockTimeout = 60;
+
+  /**
+   * {@inheritdoc}
+   */
+  public static function create(ContainerInterface $container, array $configuration, $plugin_id, $plugin_definition): static {
+    /** @var static $tracker */
+    $tracker = parent::create($container, $configuration, $plugin_id, $plugin_definition);
+    $tracker->setUuidService($container->get('uuid'));
+    return $tracker;
+  }
+
+  /**
+   * Retrieves the UUID service.
+   *
+   * @return \Drupal\Component\Uuid\UuidInterface
+   *   The UUID service.
+   */
+  public function getUuidService(): UuidInterface {
+    return $this->uuidService ?? \Drupal::service('uuid');
+  }
+
+  /**
+   * Sets the UUID service.
+   *
+   * @param \Drupal\Component\Uuid\UuidInterface $uuid_service
+   *   The UUID service.
+   *
+   * @return $this
+   */
+  public function setUuidService(UuidInterface $uuid_service): static {
+    $this->uuidService = $uuid_service;
+    return $this;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function defaultConfiguration(): array {
+    return parent::defaultConfiguration() + [
+      'claim_timeout' => 60,
+    ];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function buildConfigurationForm(array $form, FormStateInterface $form_state): array {
+    $form = parent::buildConfigurationForm($form, $form_state);
+
+    $form['claim_timeout'] = [
+      '#type' => 'number',
+      '#title' => $this->t('Claim timeout (in seconds)'),
+      '#description' => $this->t('The maximum amount of time to allow for the indexing of a single batch of items. In doubt, the default of 60 seconds should work well for most sites.'),
+      '#default_value' => $this->configuration['claim_timeout'],
+      '#min' => 30,
+      '#max' => 3600,
+    ];
+
+    return $form;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getLockId(): string {
+    // Use a different lock ID to avoid conflicts.
+    return "search_api:parallel_index:{$this->getIndex()->id()}";
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function lock($timeout = 60): bool {
+    // Store the timeout for use in claiming operations.
+    $this->lockTimeout = $timeout;
+
+    // For parallel tracker, the "lock" is really claiming items.
+    // We don't use a global lock, but we do clean up expired claims.
+    $this->releaseExpiredClaims();
+
+    // Initialize worker ID for this indexing session.
+    $this->currentWorkerId = $this->getUuidService()->generate();
+
+    return TRUE;
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function unlock(): void {
+    // Release any items claimed by this worker.
+    if ($this->currentWorkerId) {
+      $this->releaseWorkerItems($this->currentWorkerId);
+      $this->currentWorkerId = NULL;
+    }
+    $this->claimedItemIds = [];
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function createRemainingItemsStatement($datasource_id = NULL): SelectInterface {
+    return parent::createRemainingItemsStatement($datasource_id)
+      ->isNull('worker_id');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getRemainingItems($limit = -1, $datasource_id = NULL): array {
+    try {
+      // If no worker ID is set, fall back to parent implementation.
+      if (!$this->currentWorkerId) {
+        return parent::getRemainingItems($limit, $datasource_id);
+      }
+
+      $index_id = $this->getIndex()->id();
+      $lock_name = "search_api_parallel_claim:{$index_id}";
+
+      // Loop until we get the lock or timeout is reached.
+      $expiration_time = $this->getTimeService()->getCurrentTime() + $this->lockTimeout;
+      $lock_acquired = FALSE;
+
+      while (!$lock_acquired && $this->getTimeService()->getCurrentTime() < $expiration_time) {
+        // Wait for any other worker to finish claiming, then try to acquire the lock.
+        \Drupal::service('lock')->wait($lock_name, 2);
+        $lock_acquired = \Drupal::service('lock')->acquire($lock_name, 5);
+
+        if (!$lock_acquired) {
+          // Sleep briefly before retrying to avoid busy waiting.
+          usleep(100000);
+        }
+      }
+
+      if (!$lock_acquired) {
+        // Could not acquire lock within timeout - return empty array.
+        return [];
+      }
+
+      try {
+        // Get items using parent method (now selects only unclaimed items).
+        $item_ids = parent::getRemainingItems($limit, $datasource_id);
+
+        if (empty($item_ids)) {
+          return [];
+        }
+
+        $this->claimItems($item_ids);
+
+        return $item_ids;
+      }
+      finally {
+        // Always release the lock.
+        \Drupal::service('lock')->release($lock_name);
+      }
+    }
+    catch (\Exception $e) {
+      $this->logException($e);
+      return [];
+    }
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function claimItems(array $ids): void {
+    $current_time = $this->getTimeService()->getCurrentTime();
+    $expires_at = $current_time + $this->configuration['claim_timeout'];
+
+    foreach (array_chunk($ids, 1000) as $ids_chunk) {
+      $this->createUpdateStatement()
+        ->fields([
+          'status' => static::STATUS_CLAIMED,
+          'worker_id' => $this->currentWorkerId,
+          'expires_at' => $expires_at,
+        ])
+        ->condition('item_id', $ids_chunk, 'IN')
+        ->condition('status', static::STATUS_NOT_INDEXED)
+        ->isNull('worker_id')
+        ->execute();
+    }
+    $this->claimedItemIds += array_fill_keys($ids, TRUE);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function createClaimedItemsUpdateStatement() {
+    return parent::createClaimedItemsUpdateStatement()
+      ->condition('worker_id', $this->currentWorkerId);
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function createUnclaimedItemsUpdateStatement() {
+    // Items claimed by another worker are left to that worker.
+    return parent::createUnclaimedItemsUpdateStatement()
+      ->isNull('worker_id');
+  }
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function trackClaimedItemsIndexed(array $ids): void {
+    parent::trackClaimedItemsIndexed($ids);
+
+    // Also release the items updated since being claimed, so they are queued.
+    foreach (array_chunk($ids, 1000) as $ids_chunk) {
+      $this->createUpdateStatement()
+        ->fields([
+          'worker_id' => NULL,
+          'expires_at' => NULL,
+        ])
+        ->condition('item_id', $ids_chunk, 'IN')
+        ->condition('worker_id', $this->currentWorkerId)
+        ->execute();
+    }
+  }
+
+  /**
+   * Releases expired claims so items can be processed by other workers.
+   */
+  protected function releaseExpiredClaims(): void {
+    try {
+      $current_time = $this->getTimeService()->getCurrentTime();
+
+      $this->createUpdateStatement()
+        ->fields(['status' => static::STATUS_NOT_INDEXED])
+        ->condition('expires_at', $current_time, '<')
+        ->condition('status', static::STATUS_CLAIMED)
+        ->execute();
+      $this->createUpdateStatement()
+        ->fields([
+          'worker_id' => NULL,
+          'expires_at' => NULL,
+        ])
+        ->condition('expires_at', $current_time, '<')
+        ->isNotNull('worker_id')
+        ->execute();
+    }
+    catch (\Exception $e) {
+      $this->logException($e);
+    }
+  }
+
+  /**
+   * Releases all items claimed by a specific worker.
+   *
+   * @param string $worker_id
+   *   The worker ID.
+   */
+  protected function releaseWorkerItems(string $worker_id): void {
+    try {
+      $this->createUpdateStatement()
+        ->fields(['status' => static::STATUS_NOT_INDEXED])
+        ->condition('worker_id', $worker_id)
+        ->condition('status', static::STATUS_CLAIMED)
+        ->execute();
+      $this->createUpdateStatement()
+        ->fields([
+          'worker_id' => NULL,
+          'expires_at' => NULL,
+        ])
+        ->condition('worker_id', $worker_id)
+        ->execute();
+    }
+    catch (\Exception $e) {
+      $this->logException($e);
+    }
+  }
+
+}
