+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $this->assertEquals([$updated], $trackerB->getRemainingItems());
+  }
+
+  /**
+   * Tests that indexing outside a claim does not clear a pending update.
+   *
+   * @covers ::trackItemsIndexed
+   */
+  public function testUnclaimedIndexingKeepsClaimedItemQueued(): void {
+    [$item] = $this->insertItems(['a']);
+
+    $this->tracker->lock();
+    $this->assertEquals([$item], $this->tracker->getRemainingItems());
+
+    // Another process saves the item, then indexes it without a claim, as
+    // post-request indexing does.
+    $this->createSecondTracker()->trackItemsUpdated([$item]);
+    $this->createSecondTracker()->trackItemsIndexed([$item]);
+    $row = $this->getItemRow($item);
+    $this->assertEquals(TrackerPluginBase::STATUS_NOT_INDEXED, $row->status);
+    $this->assertNotNull($row->worker_id);
+
+    $this->tracker->trackItemsIndexed([$item]);
+    $this->tracker->unlock();
+
+    $row = $this->getItemRow($item);
+    $this->assertEquals(TrackerPluginBase::STATUS_NOT_INDEXED, $row->status);
+    $this->assertNull($row->worker_id);
+    $this->assertNull($row->expires_at);
+
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $this->assertEquals([$item], $trackerB->getRemainingItems());
+  }
+
+  /**
+   * Tests that a bulk requeue during a claim keeps the claimed items queued.
+   *
+   * @param string|null $datasource_id
+   *   The datasource ID passed to trackAllItemsUpdated(), or NULL for all.
+   *
+   * @covers ::trackItemsIndexed
+   *
+   * @dataProvider bulkRequeueDataProvider
+   */
+  public function testBulkRequeueWhileClaimedKeepsItemsQueued(?string $datasource_id): void {
+    $ids = $this->insertItems(['a', 'b']);
+
+    $this->tracker->lock();
+    $claimed = $this->tracker->getRemainingItems();
+    $this->assertCount(2, $claimed);
+
+    $this->createSecondTracker()->trackAllItemsUpdated($datasource_id);
+    $this->tracker->trackItemsIndexed($claimed);
+    $this->tracker->unlock();
+
+    foreach ($ids as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertEquals(TrackerPluginBase::STATUS_NOT_INDEXED, $row->status);
+      $this->assertNull($row->worker_id);
+    }
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $this->assertEqualsCanonicalizing($ids, $trackerB->getRemainingItems());
+  }
+
+  /**
+   * Provides test data for testBulkRequeueWhileClaimedKeepsItemsQueued().
+   *
+   * @return array
+   *   An array of argument arrays for
+   *   testBulkRequeueWhileClaimedKeepsItemsQueued().
+   */
+  public static function bulkRequeueDataProvider(): array {
+    return [
+      'All datasources' => [NULL],
+      'One datasource' => ['test'],
+    ];
+  }
+
+  /**
+   * Tests that two workers claim non-overlapping sets of items.
+   *
+   * @covers ::getRemainingItems
+   */
+  public function testTwoWorkersNonOverlappingClaims(): void {
+    $ids = $this->insertItems(['a', 'b', 'c', 'd', 'e', 'f']);
+
+    // Worker A claims 3 items.
+    $this->tracker->lock();
+    $claimedA = $this->tracker->getRemainingItems(3);
+    $this->assertCount(3, $claimedA);
+
+    // Worker B is a separate plugin instance pointing at the same index.
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $claimedB = $trackerB->getRemainingItems(3);
+    $this->assertCount(3, $claimedB);
+
+    // The two sets must be disjoint.
+    $overlap = array_intersect($claimedA, $claimedB);
+    $this->assertEmpty($overlap, 'Workers A and B must claim different items.');
+
+    // Together they cover all 6 items.
+    $union = array_unique(array_merge($claimedA, $claimedB));
+    sort($union);
+    sort($ids);
+    $this->assertEquals($ids, $union);
+  }
+
+  /**
+   * Tests that expired claims are released and reclaimable.
+   *
+   * @covers ::lock
+   * @covers ::getRemainingItems
+   */
+  public function testClaimExpiryReleasesItems(): void {
+    $this->insertItems(['a', 'b', 'c']);
+
+    // Worker A claims all items.
+    $this->tracker->lock();
+    $claimedA = $this->tracker->getRemainingItems(3);
+    $this->assertCount(3, $claimedA);
+
+    // Advance time past the default 60-second claim_timeout.
+    $this->timeService->advanceTime(61);
+
+    // Worker B calls lock(), which triggers releaseExpiredClaims().
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+
+    // Worker B should now be able to claim the expired items.
+    $claimedB = $trackerB->getRemainingItems(3);
+    $this->assertCount(3, $claimedB);
+
+    sort($claimedA);
+    sort($claimedB);
+    $this->assertEquals($claimedA, $claimedB, 'Worker B should reclaim the expired items from Worker A.');
+  }
+
+  /**
+   * Tests that a worker finishing after its claims expired leaves them alone.
+   *
+   * @covers ::trackItemsIndexed
+   * @covers ::unlock
+   */
+  public function testExpiredWorkerLeavesReclaimedItems(): void {
+    $ids = $this->insertItems(['a', 'b']);
+
+    $this->tracker->lock();
+    $claimedA = $this->tracker->getRemainingItems();
+    $this->assertCount(2, $claimedA);
+
+    $this->timeService->advanceTime(61);
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $claimedB = $trackerB->getRemainingItems();
+    $this->assertEqualsCanonicalizing($claimedA, $claimedB);
+    $workerB = $this->getItemRow($ids[0])->worker_id;
+    $this->assertNotNull($workerB);
+
+    // Worker A was only slow: it still finishes its batch.
+    $this->tracker->trackItemsIndexed($claimedA);
+    $this->tracker->unlock();
+    foreach ($ids as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertEquals(TrackerPluginBase::STATUS_CLAIMED, $row->status);
+      $this->assertEquals($workerB, $row->worker_id);
+    }
+
+    $trackerB->trackItemsIndexed($claimedB);
+    foreach ($ids as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertEquals(TrackerPluginBase::STATUS_INDEXED, $row->status);
+      $this->assertNull($row->worker_id);
+    }
+  }
+
+  /**
+   * Tests that unlock() releases uncompleted claims.
+   *
+   * @covers ::unlock
+   */
+  public function testUnlockReleasesUncompletedClaims(): void {
+    $this->insertItems(['a', 'b', 'c']);
+
+    // Worker A claims items but does NOT call trackItemsIndexed().
+    $this->tracker->lock();
+    $claimedA = $this->tracker->getRemainingItems(3);
+    $this->assertCount(3, $claimedA);
+    $this->assertClaimedCount(3);
+
+    // Worker A unlocks without indexing.
+    $this->tracker->unlock();
+    $this->assertClaimedCount(0);
+
+    // Worker B can now claim the same items.
+    $trackerB = $this->createSecondTracker();
+    $trackerB->lock();
+    $claimedB = $trackerB->getRemainingItems(3);
+    $this->assertCount(3, $claimedB);
+  }
+
+  /**
+   * Tests the fallback behaviour when no lock() has been called.
+   *
+   * @covers ::getRemainingItems
+   */
+  public function testNoLockFallbackBehavesLikeBasic(): void {
+    $ids = $this->insertItems(['a', 'b', 'c']);
+
+    // Call getRemainingItems() without lock() — currentWorkerId is NULL.
+    $returned = $this->tracker->getRemainingItems(3);
+    $this->assertCount(3, $returned);
+
+    // No worker_id or expires_at should be set in the DB.
+    foreach ($ids as $id) {
+      $row = $this->getItemRow($id);
+      $this->assertNull($row->worker_id, "worker_id must remain NULL in fallback mode for $id");
+      $this->assertNull($row->expires_at, "expires_at must remain NULL in fallback mode for $id");
+    }
+  }
+
+  /**
+   * Inserts items into the tracker and returns their combined IDs.
+   *
+   * @param string[] $raw_ids
+   *   Raw item IDs to insert under the 'test' datasource.
+   *
+   * @return string[]
+   *   The combined item IDs.
+   */
+  protected function insertItems(array $raw_ids): array {
+    $ids = array_map(
+      fn($raw) => Utility::createCombinedId('test', $raw),
+      $raw_ids,
+    );
+    $this->tracker->trackItemsInserted($ids);
+    return $ids;
+  }
+
+  /**
+   * Creates a second independent tracker instance for the same index.
+   *
+   * Uses the plugin manager directly to avoid the cached $trackerInstance on
+   * the Index entity.
+   *
+   * @return \Drupal\search_api\Plugin\search_api\tracker\Parallel
+   *   A fresh Parallel tracker instance sharing the same DB rows.
+   */
+  protected function createSecondTracker(): Parallel {
+    /** @var \Drupal\search_api\Plugin\search_api\tracker\Parallel $tracker */
+    $tracker = \Drupal::service('plugin.manager.search_api.tracker')
+      ->createInstance('parallel', ['#index' => $this->index]);
+    $tracker->setTimeService($this->timeService);
+    return $tracker;
+  }
+
+  /**
+   * Fetches a single item row from the tracking table.
+   *
+   * @param string $item_id
+   *   The combined item ID.
+   *
+   * @return object
+   *   A stdClass with status, worker_id, and expires_at properties.
+   */
+  protected function getItemRow(string $item_id): object {
+    return \Drupal::database()
+      ->select('search_api_item', 'i')
+      ->fields('i', ['status', 'worker_id', 'expires_at'])
+      ->condition('index_id', 'index')
+      ->condition('item_id', $item_id)
+      ->execute()
+      ->fetchObject();
+  }
+
+  /**
+   * Asserts the number of rows currently holding an active worker claim.
+   *
+   * @param int $expected
+   *   Expected count of rows with a non-NULL worker_id.
+   */
+  protected function assertClaimedCount(int $expected): void {
+    $count = (int) \Drupal::database()
+      ->select('search_api_item', 'i')
+      ->condition('index_id', 'index')
+      ->isNotNull('worker_id')
+      ->countQuery()
+      ->execute()
+      ->fetchField();
+    $this->assertEquals($expected, $count, "Expected $expected claimed rows, found $count.");
+  }
+
+}
